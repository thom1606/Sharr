# Your Plex token (required)
PLEX_OWNER_TOKEN=

# Comma separated tokens of extra users whose watchlist should be included
PLEX_EXTRA_USER_TOKENS=

# Set to true to keep media that is streamable on one of your preferred services
IGNORE_PREFERRED_SERVICES=false

# The port the service listens on
PORT=6464

# How long a fetched watchlist is reused, in seconds. 0 disables caching
CACHE_TTL_SECONDS=300

# Timeout for a single request to the Plex API, in seconds
PLEX_TIMEOUT_SECONDS=15
